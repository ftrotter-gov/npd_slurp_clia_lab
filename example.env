# NPD CLIA Lab Slurp Configuration
# Copy this file to .env and customize for your environment
#
#   cp example.env .env

# Directory where the downloaded CLIA CSV is cached.
# Created automatically if it does not exist.
# If this is unset (or there is no .env file at all), the download is placed
# in local_cache, which is .gitignored.
CLIA_CACHE_DIR=local_cache

# Network timeout in seconds for each HTTP request.
# The server takes roughly 10 seconds to generate the ~58MB export before it
# redirects, and streaming the file takes a while longer, so keep this generous.
CLIA_TIMEOUT_SECONDS=900

# Directory that split_clia_to_json.py writes the per-laboratory JSON into,
# laid out as <STATE>/<CLIA_ID>.json.
#
# This normally points at the companion cache repository checked out alongside
# this one, so that each run produces a reviewable commit there:
#
#   https://github.com/ftrotter-gov/npd_slurp_clia_lab_cache
CLIA_JSON_DIR=../npd_slurp_clia_lab_cache/cache/json
