# Downloaded data cache
# The CLIA export is ~58MB and is regenerated on demand, so it is never
# committed. The ReadMe.md keeps the directory present in a fresh clone.
# (Note: a leading "./" does not match anything in gitignore, so the path
# here is intentionally written without it.)
local_cache/*
!local_cache/ReadMe.md

# Environments
.env
.venv
venv/
env/
ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Logs
*.log
logs/*

# macOS
.DS_Store
